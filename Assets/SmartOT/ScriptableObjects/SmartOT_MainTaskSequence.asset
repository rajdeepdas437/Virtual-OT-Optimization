%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c67b5e3d4fbcb464dad635676472cb2b, type: 3}
  m_Name: SmartOT_MainTaskSequence
  m_EditorClassIdentifier: Assembly-CSharp::SmartOT.Core.TaskSequence
  tasks:
  - taskName: Take report pad from table and inspect patient
    taskDescription: Grab the report pad from the table, bring it to the patient and press E to inspect.
    phase: 1
  - taskName: Attach Oxygen Mask
    taskDescription: Grab the oxygen mask and attach it to the patient's mouth.
    phase: 1
  - taskName: Activate Patient Monitor
    taskDescription: Approach the Patient Monitor and press E to switch it on.
    phase: 1
  - taskName: Take IV cuff from IV pole and attach to patient's left bicep
    taskDescription: Grab the IV cuff from the IV pole and attach it to the patient's left bicep.
    phase: 1
  - taskName: Activate Video Monitor
    taskDescription: Approach the Video Monitor and press E to activate imaging.
    phase: 2
  - taskName: Switch On Surgical Lights
    taskDescription: Approach the surgical light switch and press E to turn on the lights.
    phase: 2
  - taskName: Take report pad and record monitor readings
    taskDescription: Grab the report pad, approach the patient monitor and press E to record readings.
    phase: 2
  - taskName: Take trocar from table and place it on left side of abdomen
    taskDescription: Grab the trocar from the table and place it at the designated abdominal insertion point.
    phase: 3
  - taskName: Take laparoscope from table and place it over the trocar
    taskDescription: Grab the laparoscope from the table and insert it through the trocar port.
    phase: 3
