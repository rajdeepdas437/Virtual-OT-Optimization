%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c67b5e3d4fbcb464dad635676472cb2b, type: 3}
  m_Name: SmartOT_MainTaskSequence
  m_EditorClassIdentifier: Assembly-CSharp::SmartOT.Core.TaskSequence
  tasks:
  - taskName: Inspect Patient
    taskDescription: Grab the report pad, bring it to the patient and press E to inspect.
    phase: 1
  - taskName: Activate Anesthesia Machine
    taskDescription: Approach the Anesthesia Machine and press E to switch it on.
    phase: 1
  - taskName: Activate Patient Monitor
    taskDescription: Approach the Patient Monitor and press E to switch it on.
    phase: 1
  - taskName: Attach IV Tube
    taskDescription: Grab the IV tube and attach it to the patient's IV point.
    phase: 1
  - taskName: Activate Laparoscopy Tower
    taskDescription: Approach the Laparoscopy Tower and press E to activate imaging.
    phase: 2
  - taskName: Switch On Surgical Lights
    taskDescription: Approach the surgical light switch and press E to turn on the lights.
    phase: 2
  - taskName: Record Monitor Readings
    taskDescription: Grab the report pad, approach the patient monitor and press E to record readings.
    phase: 2
